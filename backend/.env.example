# ── Server ────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=moedah
DB_PASSWORD=moedahsecret
DB_NAME=moedah_pos
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h   # 7 days

# ── Bcrypt ────────────────────────────────────────────────────
BCRYPT_COST=12

# ── Migrations ────────────────────────────────────────────────
RUN_MIGRATIONS=true
MIGRATIONS_DIR=./migrations
