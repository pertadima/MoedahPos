erDiagram
    users {
        UUID id PK
        VARCHAR name
        VARCHAR email
        VARCHAR password_hash
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    stores {
        UUID id PK
        VARCHAR name
        TEXT address
        VARCHAR phone
        VARCHAR tax_number
        CHAR currency
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
        VARCHAR store_type
        NUMERIC default_tax_percentage
    }
    roles {
        UUID id PK
        VARCHAR name
        TEXT description
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    permissions {
        UUID id PK
        VARCHAR name
        TEXT description
    }
    role_permissions {
        UUID role_id FK
        UUID permission_id FK
    }
    user_stores {
        UUID id PK
        UUID user_id FK
        UUID store_id FK
        UUID role_id FK
        BOOLEAN is_active
        TIMESTAMPTZ created_at
    }
    refresh_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token_hash
        TIMESTAMPTZ expires_at
        BOOLEAN revoked
        TIMESTAMPTZ created_at
    }
    categories {
        UUID id PK
        UUID store_id FK
        VARCHAR name
        UUID parent_id FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ server_updated_at
        INT sync_version
    }
    products {
        UUID id PK
        UUID store_id FK
        UUID category_id FK
        VARCHAR sku
        VARCHAR name
        TEXT description
        VARCHAR barcode
        VARCHAR unit
        NUMERIC cost_price
        NUMERIC sell_price
        NUMERIC tax_percentage
        BOOLEAN use_global_tax
        TEXT image_url
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ server_updated_at
        INT sync_version
    }
    stock_levels {
        UUID id PK
        UUID product_id FK
        UUID store_id FK
        NUMERIC quantity
        NUMERIC min_quantity
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ server_updated_at
        INT sync_version
    }
    stock_movements {
        UUID id PK
        UUID product_id FK
        UUID store_id FK
        VARCHAR ref_type
        UUID ref_id
        NUMERIC quantity_delta
        TEXT notes
        UUID created_by FK
        TIMESTAMPTZ created_at
    }
    suppliers {
        UUID id PK
        VARCHAR name
        VARCHAR contact_name
        VARCHAR phone
        VARCHAR email
        TEXT address
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    purchase_orders {
        UUID id PK
        UUID store_id FK
        UUID supplier_id FK
        VARCHAR po_number
        VARCHAR status
        NUMERIC total_amount
        UUID ordered_by FK
        UUID received_by FK
        TIMESTAMPTZ ordered_at
        TIMESTAMPTZ received_at
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    purchase_order_items {
        UUID id PK
        UUID po_id FK
        UUID product_id FK
        NUMERIC quantity
        NUMERIC unit_cost
        NUMERIC received_qty
        NUMERIC subtotal
    }
    transactions {
        UUID id PK
        UUID store_id FK
        UUID cashier_id FK
        VARCHAR customer_name
        VARCHAR customer_phone
        NUMERIC subtotal
        NUMERIC discount_amt
        NUMERIC tax_amt
        NUMERIC total
        VARCHAR payment_method
        NUMERIC payment_amount
        NUMERIC change_amount
        VARCHAR status
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        UUID table_id FK
        VARCHAR order_type
        UUID customer_id FK
        VARCHAR cart_discount_type
        NUMERIC cart_discount_value
        TIMESTAMPTZ server_updated_at
        INT sync_version
    }
    transaction_items {
        UUID id PK
        UUID transaction_id FK
        UUID product_id FK
        VARCHAR product_name
        VARCHAR sku
        NUMERIC quantity
        NUMERIC unit_price
        NUMERIC discount_pct
        NUMERIC tax_rate
        NUMERIC subtotal
        UUID menu_item_id FK
        NUMERIC cost_price
        VARCHAR status
        TIMESTAMPTZ completed_at
        NUMERIC original_price
        VARCHAR discount_type
        NUMERIC discount_value
        NUMERIC cart_discount_allocated
    }
