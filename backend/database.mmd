        UUID id PK
        UUID store_id FK
        VARCHAR table_number
        INT capacity
        VARCHAR status
        TEXT notes
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    menu_items {
        UUID id PK
        UUID store_id FK
        UUID category_id FK
        VARCHAR name
        TEXT description
        NUMERIC sell_price
        NUMERIC tax_percentage
        BOOLEAN use_global_tax
        NUMERIC packaging_cost
        NUMERIC overhead_cost
        NUMERIC labor_cost
        TEXT image_url
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    menu_item_ingredients {
        UUID id PK
        UUID menu_item_id FK
        UUID product_id FK
        NUMERIC quantity
    }
    price_history {
        UUID id PK
        UUID product_id FK
        UUID store_id FK
        UUID changed_by FK
        NUMERIC old_cost
        NUMERIC new_cost
        NUMERIC old_sell
        NUMERIC new_sell
        VARCHAR source
        UUID ref_id
        TEXT notes
        TIMESTAMPTZ changed_at
    }
    po_payments {
        UUID id PK
        UUID po_id FK
        UUID store_id FK
        NUMERIC amount
        TEXT note
        UUID paid_by FK
        TIMESTAMPTZ paid_at
    }
    customers {
        UUID id PK
        UUID store_id FK
        VARCHAR name
        VARCHAR phone
        VARCHAR email
        TEXT address
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    stock_batches {
        UUID id PK
        UUID product_id FK
        UUID store_id FK
        UUID po_id FK
        NUMERIC quantity_remaining
        NUMERIC purchase_price
        TIMESTAMPTZ received_at
        TIMESTAMPTZ created_at
    }
    purchase_order_termins {
        UUID id PK
        UUID po_id FK
        INT termin_number
        NUMERIC amount
        DATE due_date
        TEXT status
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    payment_records {
        UUID id PK
        UUID termin_id FK
        NUMERIC amount_paid
        DATE payment_date
        TEXT payment_method
        TEXT notes
        UUID recorded_by FK
        TIMESTAMPTZ created_at
    }
    expense_categories {
        UUID id PK
        VARCHAR name
        TEXT description
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    expenses {
        UUID id PK
        UUID store_id FK
        UUID category_id FK
        NUMERIC amount
        DATE expense_date
        TEXT notes
        UUID created_by FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        VARCHAR payment_status
    }
    recurring_expenses {
        UUID id PK
        UUID store_id FK
        UUID category_id FK
        VARCHAR name
        NUMERIC amount
        VARCHAR interval
        INT interval_value
        DATE start_date
        DATE end_date
        DATE next_run_date
        TEXT notes
        BOOLEAN is_active
        UUID created_by FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ last_generated_at
    }
    stock_adjustments {
        UUID id PK
        UUID product_id FK
        UUID store_id FK
        adjustment_type type
        adjustment_reason reason
        NUMERIC quantity
        TEXT notes
        UUID created_by FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    stock_adjustment_batches {
        UUID id PK
        UUID adjustment_id FK
        UUID batch_id FK
        NUMERIC deducted_qty
    }
    income_categories {
        UUID id PK
        VARCHAR name
        TEXT description
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    incomes {
        UUID id PK
        UUID store_id FK
        UUID category_id FK
        NUMERIC amount
        DATE income_date
        VARCHAR payment_method
        VARCHAR reference
        TEXT notes
        UUID created_by FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    activity_logs {
        UUID id PK
        UUID user_id FK
        UUID store_id FK
        action_type_enum action_type
        VARCHAR module
        UUID reference_id
        JSONB metadata
        TIMESTAMPTZ created_at
    }
